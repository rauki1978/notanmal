---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  image?: string;
}

const { title, subtitle, description, image } = Astro.props;
---

<BaseLayout title={`${title} - #NoTanMal`} description={description} image={image}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <header class="mb-12 lg:mb-16 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-text-main mb-4 lg:mb-6">
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg sm:text-xl text-text-muted max-w-2xl mx-auto">
          {subtitle}
        </p>
      )}
    </header>
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>
  </div>
</BaseLayout>
