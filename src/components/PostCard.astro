---
interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: string;
  slug: string;
}

const { title, excerpt, category, date, slug } = Astro.props;

// Formatear fecha
const formattedDate = new Date(date).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="bg-white rounded-xl border border-gray-200 hover:border-brand-yellow transition-all p-6 group">
  <div class="flex items-center gap-3 mb-4">
    <span class="text-xs font-semibold text-brand-yellow bg-brand-yellow/10 px-3 py-1 rounded-full">
      {category}
    </span>
    <time class="text-sm text-text-muted">{formattedDate}</time>
  </div>

  <h3 class="text-xl font-bold text-text-main mb-3 group-hover:text-brand-yellow transition-colors">
    <a href={`/posts/${slug}`} class="hover:underline">
      {title}
    </a>
  </h3>

  <p class="text-text-muted mb-4 line-clamp-3">
    {excerpt}
  </p>

  <a
    href={`/posts/${slug}`}
    class="inline-flex items-center text-sm font-medium text-text-main hover:text-brand-yellow transition-colors"
  >
    Leer más
    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </a>
</article>
