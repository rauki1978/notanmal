---
interface Props {
  quote: string;
  showLink?: boolean;
}

const { quote, showLink = false } = Astro.props;
---

<section class="bg-white rounded-2xl p-10 lg:p-12 shadow-[3px_3px_0_rgba(0,0,0,0.05)] border-2 border-gray-200">
  <div class="max-w-3xl mx-auto text-center">
    <h3 class="text-sm font-semibold text-brand-yellow mb-4 uppercase tracking-wide">
      Frase del día (o del desastre)
    </h3>

    <blockquote class="text-2xl sm:text-3xl lg:text-4xl font-medium text-text-main mb-6 leading-relaxed">
      "{quote}"
    </blockquote>

    {showLink && (
      <a
        href="/posts"
        class="inline-flex items-center text-text-muted hover:text-brand-yellow transition-colors font-medium"
      >
        Ver más frases
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    )}
  </div>
</section>
