---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/universo', label: 'Universo' },
  { href: '/libro', label: 'Libro' },
  { href: '/tienda', label: 'Tienda' },
  { href: '/posts', label: 'Posts' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b-2 border-gray-200 border-t-2 border-t-brand-yellow shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-center md:justify-between items-center h-16">
      <!-- Logo mejorado con estilo neubrutalist -->
      <a href="/" class="flex items-center gap-3 group">
        <span class="text-2xl sm:text-3xl font-black">
          <span class="text-brand-yellow">#</span><span class="text-text-main">NoTanMal</span>
        </span>
        <span class="hidden sm:inline-block px-3 py-1.5 bg-brand-yellow text-black text-xs font-bold tracking-wider border border-black rounded-md uppercase shadow-[2px_2px_0_rgba(0,0,0,0.7)] group-hover:shadow-[3px_3px_0_rgba(0,0,0,0.7)] group-hover:translate-x-[-1px] group-hover:translate-y-[-1px] transition-all">
          Manual de supervivencia
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-base font-semibold transition-colors hover:text-brand-yellow relative ${
              currentPath === item.href ? 'text-brand-yellow' : 'text-text-muted'
            }`}
          >
            {item.label}
            {currentPath === item.href && (
              <span class="absolute -bottom-1 left-0 right-0 h-1 bg-brand-yellow rounded-full"></span>
            )}
          </a>
        ))}
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Abrir menú"
      >
        <svg
          id="menu-icon-open"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        <svg
          id="menu-icon-close"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation - UX mejorado -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 py-6 space-y-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-5 py-4 text-base font-semibold rounded-lg transition-all ${
            currentPath === item.href
              ? 'text-brand-yellow bg-brand-yellow/10 border-l-4 border-brand-yellow'
              : 'text-text-muted hover:text-brand-yellow hover:bg-gray-50'
          }`}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  // Toggle mobile menu with icon animation
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  mobileMenuButton?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');

    // Toggle icons
    menuIconOpen?.classList.toggle('hidden', !isHidden);
    menuIconClose?.classList.toggle('hidden', isHidden);
  });

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!mobileMenuButton?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
    }
  });

  // Close menu when clicking on a link (better UX)
  const mobileMenuLinks = mobileMenu?.querySelectorAll('a');
  mobileMenuLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
    });
  });
</script>
