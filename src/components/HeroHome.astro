---
// Hero principal para la página de inicio
---

<section class="relative overflow-hidden bg-background py-20 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-text-main mb-6 lg:mb-8 leading-tight">
        No es el fin del mundo.<br />
        <span class="text-brand-yellow">Solo parece.</span>
      </h1>

      <p class="text-lg sm:text-xl lg:text-2xl text-text-muted mb-10 lg:mb-12 max-w-3xl mx-auto leading-relaxed">
        #NoTanMal es humor, cultura y supervivencia mental para gente sensata
        que vive en un mundo bastante absurdo.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/universo"
          class="w-full sm:w-auto px-8 py-4 bg-brand-yellow text-text-main font-semibold rounded-xl hover:bg-yellow-400 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
        >
          Explorar el universo
        </a>
        <a
          href="/tienda"
          class="w-full sm:w-auto px-8 py-4 bg-white text-text-main font-semibold rounded-xl border-2 border-gray-200 hover:border-brand-yellow transition-all"
        >
          Ver camisetas
        </a>
      </div>
    </div>
  </div>

  <!-- Decoración opcional -->
  <div class="absolute top-0 left-0 w-72 h-72 bg-brand-yellow/5 rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-brand-purple/5 rounded-full blur-3xl -z-10"></div>
</section>
