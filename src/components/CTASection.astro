---
interface Props {
  title: string;
  subtitle?: string;
  buttonText?: string;
}

const {
  title,
  subtitle = 'Únete a gente sensata. Sin spam, sin promesas imposibles.',
  buttonText = 'Suscribirme'
} = Astro.props;
---

<section class="bg-brand-yellow text-black py-16 lg:py-24 rounded-2xl my-16 border-2 border-black shadow-[5px_5px_0_rgba(0,0,0,0.8)]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-4 leading-tight">
      {title}
    </h2>

    {subtitle && (
      <p class="text-lg sm:text-xl mb-10 font-bold">
        {subtitle}
      </p>
    )}

    <form class="max-w-lg mx-auto flex flex-col sm:flex-row gap-3">
      <input
        type="email"
        placeholder="tu-email-sin-presion@gmail.com"
        required
        class="flex-1 px-5 py-4 rounded-lg bg-white border-2 border-black text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-black font-medium shadow-[2px_2px_0_rgba(0,0,0,0.7)]"
      />
      <button
        type="submit"
        class="px-7 py-4 bg-black text-white font-bold rounded-lg border-2 border-black shadow-[3px_3px_0_rgba(250,204,21,0.8)] hover:shadow-[4px_4px_0_rgba(250,204,21,0.8)] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-all uppercase tracking-wide"
      >
        {buttonText} 📬
      </button>
    </form>

    <p class="text-sm mt-6 font-bold flex items-center justify-center gap-2">
      <span>✅</span> No spam. Solo contenido sensato cuando tenga algo que decir.
    </p>
  </div>
</section>
