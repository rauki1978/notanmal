---
// Banda de social proof con badges de marca - Estilo neubrutalist
---

<section class="border-y-2 border-black bg-gradient-to-r from-brand-yellow/60 via-brand-yellow/80 to-brand-yellow/60 lg:from-brand-yellow/95 lg:via-brand-yellow lg:to-brand-yellow/95 py-6 lg:py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 lg:gap-5">
      <!-- Badge: Manual de supervivencia -->
      <div class="inline-flex items-center gap-2 px-5 py-2.5 bg-white rounded-full border border-black shadow-[2px_2px_0_rgba(0,0,0,0.7)] hover:shadow-[3px_3px_0_rgba(0,0,0,0.7)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all">
        <span class="text-lg">📖</span>
        <span class="text-sm font-bold text-black uppercase tracking-wide">Manual de supervivencia</span>
      </div>

      <!-- Badge: Anti-postureo certificado -->
      <div class="inline-flex items-center gap-2 px-5 py-2.5 bg-black rounded-full border border-black shadow-[2px_2px_0_rgba(250,204,21,0.8)] hover:shadow-[3px_3px_0_rgba(250,204,21,0.8)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all">
        <span class="text-lg">🛡️</span>
        <span class="text-sm font-bold text-white uppercase tracking-wide">Anti-postureo certificado</span>
      </div>

      <!-- Badge: Sin gurús ni promesas -->
      <div class="inline-flex items-center gap-2 px-5 py-2.5 bg-white rounded-full border border-black shadow-[2px_2px_0_rgba(0,0,0,0.7)] hover:shadow-[3px_3px_0_rgba(0,0,0,0.7)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all">
        <span class="text-lg">🚫</span>
        <span class="text-sm font-bold text-black uppercase tracking-wide">0 gurús contratados</span>
      </div>

      <!-- Badge: Humor inteligente -->
      <div class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-white rounded-full border border-black shadow-[2px_2px_0_rgba(0,0,0,0.7)] hover:shadow-[3px_3px_0_rgba(0,0,0,0.7)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all">
        <span class="text-lg">✨</span>
        <span class="text-sm font-bold text-black uppercase tracking-wide">Humor inteligente</span>
      </div>
    </div>
  </div>
</section>
